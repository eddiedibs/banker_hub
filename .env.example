# HTTP
HTTP_ADDR=127.0.0.1:8080
API_TOKEN=change-me-to-a-long-random-string

# Storage
DB_PATH=banker_hub.db

# Sync
SYNC_INTERVAL=2h      # BNC only exposes the last 25 movements per account
SYNC_LOOKBACK=2160h   # first sync reaches back 90 days
LOG_LEVEL=info

# Binance (read-only API key, IP-restricted, no trading or withdrawals)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# BNC online banking
BNC_CARD=
BNC_USER_ID=
BNC_PASSWORD=
